# ==========================================
# QRShield — Git Ignore Configuration
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Python Virtual Environments
venv/
env/
ENV/
backend/venv/
.venv/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
backend/.env
*.env
# Keep template configuration tracked
!.env.example
!backend/.env.example

# Local SQLite Databases (scan history & audit data)
*.db
*.sqlite
*.sqlite3
backend/qrshield.db

# Test Caches & Coverage Reports
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# IDE & Code Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Node / Web artifacts (if added in future)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
